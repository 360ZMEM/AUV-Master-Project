# AUV Text Replay Sender Configuration
# Replays AUV packets from text log file via UDP

[sender]
# Text log file path (relative to project root)
text_file = 20020101103632.txt

# Replay interval in milliseconds (600 = AUV's actual transmission rate)
replay_interval_ms = 600

# Loop playback (true/false)
loop_playback = true

[network]
# Local endpoint (simulates AUV's address)
# The AUV would typically be at 192.168.0.101:52364
local_ip = 127.0.0.1
local_port = 52364

# Target endpoint (the console/上位机 listening address)
# The console listens at 192.168.0.11:21 for AUV packets
target_ip = 127.0.0.1
target_port = 21

[notes]
# Network Topology:
#   Real AUV: 192.168.0.101:52364 → Console: 192.168.0.11:21
#   Simulated: 127.0.0.1:52364 → Console: 127.0.0.1:21
#
# Usage:
#   1. Start this text replay sender: python text_replay_sender.py
#   2. Start AUV Console in ONLINE mode (connects to 127.0.0.1)
#   3. Console will receive packets as if from real AUV
#
# For local testing, use:
#   port_set.txt (console): 127.0.0.1:21 (console listens)
#   This config (sender): 127.0.0.1:52364 → 127.0.0.1:21
#
# For network testing, use:
#   port_set.txt (console): 192.168.0.11:21
#   This config (sender): 192.168.0.101:52364 → 192.168.0.11:21
