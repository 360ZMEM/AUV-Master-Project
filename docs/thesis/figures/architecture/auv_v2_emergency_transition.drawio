        <mxCell id="hold" value="ZERO_FALLBACK&#xa;零指令保持" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F6F7F8;strokeColor=#9AA7B2;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="130" y="640" width="220" height="100" as="geometry" /></mxCell>
