        <mxCell id="t1" value="紧急情况下的状态切换与仲裁" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=28;fontStyle=1;fontColor=#1E2732;" vertex="1" parent="1"><mxGeometry x="380" y="20" width="660" height="42" as="geometry" /></mxCell>
        <mxCell id="s1" value="AUTONOMOUS 运行中触发关键守卫后，ROS2 先回零/锁定；深度或近底风险由 PC104 本地覆盖" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=15;fontColor=#43525F;" vertex="1" parent="1"><mxGeometry x="260" y="66" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="auto" value="AUTONOMOUS&#xa;自主运行" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF6EF;strokeColor=#8DBA98;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="g1" value="链路陈旧&#xa;PC / telemetry timeout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8EEEE;strokeColor=#C68C8C;strokeWidth=2;spacing=8;shadow=0;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="220" height="66" as="geometry" /></mxCell>
        <mxCell id="g2" value="置信度不足&#xa;状态不可用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8EEEE;strokeColor=#C68C8C;strokeWidth=2;spacing=8;shadow=0;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="220" height="66" as="geometry" /></mxCell>
        <mxCell id="g3" value="漏水 / 低电压&#xa;Guard deny" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8EEEE;strokeColor=#C68C8C;strokeWidth=2;spacing=8;shadow=0;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="660" y="300" width="220" height="66" as="geometry" /></mxCell>
        <mxCell id="g4" value="操作员 ESTOP&#xa;地面站按下" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8EEEE;strokeColor=#C68C8C;strokeWidth=2;spacing=8;shadow=0;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="940" y="300" width="220" height="66" as="geometry" /></mxCell>
