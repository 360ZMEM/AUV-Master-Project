        <mxCell id="s1" value="从空闲到全自主的运行阶段，每一步都有独立准入条件与回退回路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=15;fontColor=#43525F;" vertex="1" parent="1"><mxGeometry x="460" y="66" width="720" height="34" as="geometry" /></mxCell>
        <mxCell id="st_idle" value="IDLE&#xa;上电空闲" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F6F7F8;strokeColor=#9AA7B2;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="st_pre" value="PREFLIGHT&#xa;预检 / 授权" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#D8B46A;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="290" y="190" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="st_shadow" value="SHADOW&#xa;影子导航（不夺权）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FBEFE5;strokeColor=#D4A17B;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="540" y="190" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="st_single" value="SINGLE_LOOP&#xa;单回路闭环" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#8AA9C4;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="st_full" value="FULL_AUTONOMY&#xa;全自主任务" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EEF6EF;strokeColor=#8DBA98;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="1100" y="190" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="st_done" value="COMPLETE&#xa;收尾 / 回收" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F2EDF7;strokeColor=#A996C0;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="st_hold" value="SAFE_HOLD&#xa;安全保持 / 回退" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8EEEE;strokeColor=#C68C8C;strokeWidth=2;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=16;fontColor=#26323D;" vertex="1" parent="1"><mxGeometry x="1100" y="540" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="legend" value="规则：任何一态在安全触发下都可直接迁移至 SAFE_HOLD；操作员可主动降级到 SHADOW；COMPLETE 后回到 IDLE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Noto Serif CJK SC,Times New Roman;fontSize=15;fontColor=#43525F;" vertex="1" parent="1"><mxGeometry x="100" y="810" width="1300" height="40" as="geometry" /></mxCell>
