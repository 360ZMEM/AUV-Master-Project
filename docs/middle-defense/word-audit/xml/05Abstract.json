  "paragraphs": [
    {
      "paragraph_index": 1,
      "text": "Abstract",
      "pPr": {
        "pStyle": {
          "val": "Heading1"
        },
        "spacing": {
          "before": "480",
          "after": "360"
        },
        "ind": {
