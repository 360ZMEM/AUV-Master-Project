              "hAnsi": "宋体;SimSun"
            },
            "spacing": {
              "val": "0"
            },
            "szCs": {
              "val": "24"
            }
          }
        },
        {
          "text": "副教授对本人的精心指导。他们的言传身教将使我终生受益。",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
