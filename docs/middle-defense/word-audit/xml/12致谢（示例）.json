          "text": "谢",
          "rPr": {}
        }
      ]
    },
    {
      "paragraph_index": 2,
      "text": "衷心感谢导师×××教授和物理系××副教授对本人的精心指导。他们的言传身教将使我终生受益。",
      "pPr": {
        "pStyle": {
          "val": "Style14"
        },
        "spacing": {
          "lineRule": "exact",
          "line": "400",
          "before": "0",
          "after": "0"
        },
        "ind": {
          "firstLine": "480"
        },
        "rPr": {
          "value": ""
        }
      },
      "runs": [
        {
          "text": "衷心感谢导师",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
