  "paragraphs": [
    {
      "paragraph_index": 1,
      "text": "关于学位论文使用授权的说明",
      "pPr": {
        "pStyle": {
          "val": "Normal"
        },
        "snapToGrid": {
          "val": "false"
        },
        "spacing": {
          "before": "720",
          "after": "720"
        },
        "jc": {
          "val": "center"
        },
        "rPr": {
          "value": ""
        }
      },
      "runs": [
        {
          "text": "关于学位论文使用授权的说明",
          "rPr": {
            "rFonts": {
              "ascii": "黑体;SimHei",
              "hAnsi": "黑体;SimHei",
              "eastAsia": "黑体;SimHei"
            },
            "sz": {
              "val": "44"
            }
          }
        }
      ]
    },
    {
      "paragraph_index": 2,
      "text": "本人完全了解清华大学有关保留、使用学位论文的规定，即：",
      "pPr": {
        "pStyle": {
          "val": "Normal"
        },
        "spacing": {
          "lineRule": "exact",
          "line": "520"
        },
        "ind": {
          "firstLine": "560"
        },
        "rPr": {
          "value": ""
        }
      },
      "runs": [
        {
          "text": "本人完全了解清华大学有关保留、使用学位论文的规定，即：",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        }
      ]
    },
    {
      "paragraph_index": 3,
      "text": "清华大学拥有在著作权法规定范围内学位论文的使用权，其中包括：（1）已获学位的研究生必须按学校规定提交学位论文，学校可以采用影印、缩印或其他复制手段保存研究生上交的学位论文；（2）为教学和科研目的，学校可以将公开的学位论文作为资料在图书馆、资料室等场所供校内师生阅读，或在校园网上供校内师生浏览部分内容；（3）根据《中华人民共和国学位法》及上级教育主管部门要求，报送相应的学位论文。",
      "pPr": {
        "pStyle": {
          "val": "Normal"
        },
        "snapToGrid": {
          "val": "false"
        },
        "spacing": {
          "lineRule": "exact",
          "line": "520"
        },
        "ind": {
          "firstLine": "560"
        },
        "rPr": {
          "value": ""
        }
      },
      "runs": [
        {
          "text": "清华大学拥有在著作权法规定范围内学位论文的使用权，其中包括：",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "（",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "1",
          "rPr": {
            "rFonts": {
              "cs": "宋体;SimSun",
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "）",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "已获学位的研究生必须按学校规定提交学位论文，学校可以采用影印、缩印或其他复制手段保存研究生上交的学位论文；",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "（",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "2",
          "rPr": {
            "rFonts": {
              "cs": "宋体;SimSun",
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "）为教学和科研目的，学校可以将公开的学位论文作为资料在图书馆、资料室等场所供校内师生阅读，或在校园网上供校内师生浏览部分内容；",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "（",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "3",
          "rPr": {
            "rFonts": {
              "cs": "宋体;SimSun",
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "）",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "根据《中华人民共和国学位法》",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "及上级教育主管",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "部门",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "要求",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "，报送",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "相应",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        },
        {
          "text": "的学位论文。",
          "rPr": {
            "rFonts": {
              "ascii": "宋体;SimSun",
              "hAnsi": "宋体;SimSun",
              "cs": "宋体;SimSun"
            },
            "sz": {
              "val": "28"
            },
            "szCs": {
              "val": "28"
            }
          }
        }
      ]
    },
    {
      "paragraph_index": 4,
      "text": "本人保证遵守上述规定。",
      "pPr": {
